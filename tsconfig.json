{
  // Mirrors FamCart's own tsconfig, including the two strictness flags that do
  // most of the work here (noUnusedLocals / noUnusedParameters), so a module
  // vendored from there typechecks under identical rules on both sides.
  //
  // scripts/ is deliberately out of scope: seed-dev.mjs is a plain Node script
  // that never runs in the browser and has no types to check.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "node" is here for test/ and vite.config.ts, not for src/. The vendor
    // drift test reads the manifest off disk with node:fs and node:crypto, and
    // a test that cannot be typechecked is a test nobody notices going stale.
    //
    // The cost is that Node globals are visible to src/ too, where they must
    // never be used -- this bundle runs in a browser. eslint draws that line
    // properly: globals.browser for src, globals.node only for test/ and
    // scripts/, so a stray `process.env` in a view is still caught there.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts"]
}
